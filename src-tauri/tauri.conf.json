{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wave",
  "version": "../package.json",
  "identifier": "com.mskayyali.wave",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Wave",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#161616",
        "theme": "Dark",
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$HOME/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "vendor/nemo-speech/runtime/": "nemo-speech/",
      "vendor/lame/README.md": "licenses/LAME.md",
      "vendor/lame/COPYING": "licenses/LAME-COPYING.txt"
    },
    "macOS": {
      "minimumSystemVersion": "13.4",
      "frameworks": [
        "vendor/lame/libmp3lame.0.dylib"
      ],
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA4NTBBNDU4MjhDQUNGNjUKUldSbHo4b29XS1JRQ0I0bUdzakVhckdCMEd6b3l2OWRrTGFsNE9sVTNrU0g5MXFsNWpKc1JrSzkK",
      "endpoints": [
        "https://github.com/mskayyali/wave/releases/latest/download/latest-v2.json"
      ]
    }
  }
}
