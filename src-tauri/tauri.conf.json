{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wave",
  "version": "../package.json",
  "identifier": "com.mskayyali.wave",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Wave",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#161616",
        "theme": "Dark",
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$HOME/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "vendor/lame/README.md": "licenses/LAME.md",
      "vendor/lame/COPYING": "licenses/LAME-COPYING.txt"
    },
    "macOS": {
      "minimumSystemVersion": "13.4",
      "frameworks": ["vendor/lame/libmp3lame.0.dylib"]
    }
  }
}
